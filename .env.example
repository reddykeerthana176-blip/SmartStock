# ==============================================================================
# SmartStock Environment Configuration
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
# Single node local instance or MongoDB Atlas replica set string
MONGODB_URI=mongodb://localhost:27017/smartstock
# MongoDB Connection Pool Limits (Scalability optimization)
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# Security & Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Optional Redis Cache & Queue (Falls back to high-performance in-memory queue if not connected)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Business & Inventory Constraints
MAX_PRODUCTS_PER_BUSINESS=100000
DEFAULT_SAFETY_STOCK_DAYS=7
DEFAULT_LEAD_TIME_DAYS=5

# Audit & Logging
LOG_LEVEL=info
